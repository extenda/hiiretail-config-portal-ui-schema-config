{
  "type": "ListWithDetail",
  "scope": "#",
  "options": {
    "detail": {
      "type": "Categorization",
      "elements": [
        {
          "type": "Category",
          "label": "Tender",
          "elements": [
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/id"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/name"
                }
              ]
            },
            {
              "type": "Control",
              "scope": "#/properties/type"
            },
            {
              "type": "Control",
              "scope": "#/properties/currency",
              "options": {
                "enumSource": {
                  "type": "request",
                  "request": {
                    "url": "{api:ccc-api}/api/v1/config/cur.currencies.v1/values/{target.path}"
                  },
                  "response": {
                    "itemsPath": "value",
                    "valueKey": "id",
                    "labelKey": "id"
                  }
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/type/properties/kind",
                  "schema": {
                    "enum": [
                      "foreignCurrency"
                    ]
                  }
                }
              }
            },
            {
              "type": "Label",
              "text": "Choose the tender type first. 'Cash Drawer' and 'Overpayment' (unless 'No Split Payment' is on) on the At the Till tab, and 'Refunds' on the Refunds tab (not for cash), must be chosen: Save is refused until they are. Every other setting left empty uses its default. Most saved amounts and choices cannot be cleared: Save is then refused. To go back to a default, choose it where offered, such as 'Automatic' or 'No rounding'. The payment service settings, provider codes and the store currency are added automatically."
            },
            {
              "type": "Control",
              "scope": "#/properties/description",
              "options": {
                "multi": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/disabled"
            }
          ]
        },
        {
          "type": "Category",
          "label": "At the Till",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/defaultTender"
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "VerticalLayout",
                      "elements": [
                        {
                          "type": "Label",
                          "text": "A cash changer tender is never the default cash tender: choose Automatic or No."
                        }
                      ],
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/behavior/properties/defaultTender",
                          "schema": {
                            "const": "YES"
                          }
                        }
                      }
                    }
                  ],
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/type/properties/hardware",
                      "schema": {
                        "const": "CASH_CHANGER_MACHINE"
                      }
                    }
                  }
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/type/properties/kind",
                  "schema": {
                    "const": "cash"
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/overpayment"
            },
            {
              "type": "Label",
              "text": "'No Split Payment' is on: this tender always takes the exact amount, whatever 'Overpayment' says.",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/behavior/properties/exclusive",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Choose 'Overpayment': Save is refused until it is chosen."
                    }
                  ],
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/behavior/properties/exclusive",
                      "schema": {
                        "not": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/behavior/properties/overpayment",
                  "schema": {
                    "not": {
                      "enum": [
                        "EXACT_AMOUNT",
                        "WITH_CHANGE",
                        "WITHOUT_CHANGE"
                      ]
                    }
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/exclusive"
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/lockTransaction"
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/blockCancel"
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "With 'Lock Sale After Payment Entry' and 'Block Removing the Payment' both on, the sale can only be finished by paying it in full, even when the customer cannot pay."
                    }
                  ],
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/behavior/properties/blockCancel",
                      "schema": {
                        "const": true
                      }
                    }
                  }
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/behavior/properties/lockTransaction",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/payRemainingAmount"
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/prefillAmount"
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/cashDrawer"
            },
            {
              "type": "Label",
              "text": "Choose 'Cash Drawer': Save is refused until it is chosen.",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/behavior/properties/cashDrawer",
                  "schema": {
                    "not": {
                      "enum": [
                        "OPEN",
                        "KEEP_CLOSED"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "type": "Category",
          "label": "Change",
          "elements": [
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "'Overpayment' gives no change: these settings are not used."
                    }
                  ],
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/behavior/properties/exclusive",
                      "schema": {
                        "not": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/behavior/properties/overpayment",
                  "schema": {
                    "enum": [
                      "EXACT_AMOUNT",
                      "WITHOUT_CHANGE"
                    ]
                  }
                }
              }
            },
            {
              "type": "Label",
              "text": "No change is given, because 'No Split Payment' always takes the exact amount: these settings are not used.",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/behavior/properties/exclusive",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Label",
                  "text": "Where change goes when the customer pays more than the amount due. Every setting here is optional: leave them empty to give all change in cash, in the store's default cash tender. Used only when 'Overpayment' is 'Allowed, give change'."
                },
                {
                  "type": "Label",
                  "text": "A saved amount here cannot be cleared yet: Save is then refused. The change tender list shows the tenders saved for this target: save a new tender before choosing it here. Choose an enabled tender, not loyalty points, that allows refunds, has no minimum amounts and does not have 'No Split Payment' on."
                },
                {
                  "type": "Control",
                  "scope": "#/properties/change/properties/tenderId",
                  "options": {
                    "enumSource": {
                      "type": "request",
                      "request": {
                        "url": "{api:ccc-api}/api/v1/config/che.tender.preview/values/{target.path}"
                      },
                      "response": {
                        "itemsPath": "value",
                        "valueKey": "id",
                        "labelKey": "name"
                      },
                      "display": {
                        "secondaryLabelKey": "type.kind"
                      }
                    }
                  }
                },
                {
                  "type": "HorizontalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/change/properties/threshold"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/change/properties/autoCompleteLimit"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Refunds",
          "elements": [
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Label",
                  "text": "On cash, change is paid out as a refund: cash always allows refunds, and the maximum refund also limits change."
                },
                {
                  "type": "Control",
                  "scope": "#/properties/refund/properties/skipAmountPrompt"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/refund/properties/maxAmount"
                },
                {
                  "type": "Label",
                  "text": "A saved refund amount cannot be cleared yet: Save is then refused."
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/type/properties/kind",
                  "schema": {
                    "const": "cash"
                  }
                }
              }
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/refund/properties/refundsAllowed"
                },
                {
                  "type": "Label",
                  "text": "Choose 'Refunds': Save is refused until it is chosen.",
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/refund/properties/refundsAllowed",
                      "schema": {
                        "not": {
                          "enum": [
                            "YES",
                            "NO"
                          ]
                        }
                      }
                    }
                  }
                },
                {
                  "type": "Label",
                  "text": "Refunds are blocked: the settings below are not used.",
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/refund/properties/refundsAllowed",
                      "schema": {
                        "const": "NO"
                      }
                    }
                  }
                },
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/refund/properties/skipAmountPrompt"
                    },
                    {
                      "type": "HorizontalLayout",
                      "elements": [
                        {
                          "type": "Control",
                          "scope": "#/properties/refund/properties/maxAmount"
                        },
                        {
                          "type": "Control",
                          "scope": "#/properties/refund/properties/minAmount"
                        }
                      ]
                    },
                    {
                      "type": "Label",
                      "text": "A saved refund amount cannot be cleared yet: Save is then refused."
                    }
                  ]
                }
              ],
              "rule": {
                "effect": "HIDE",
                "condition": {
                  "scope": "#/properties/type/properties/kind",
                  "schema": {
                    "const": "cash"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "Category",
          "label": "Limits",
          "elements": [
            {
              "type": "Label",
              "text": "Leave a limit empty for no limit. A saved limit cannot be cleared yet: Save is then refused."
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/limits/properties/maxPerSale"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/limits/properties/maxPerEntry"
                }
              ]
            },
            {
              "type": "Control",
              "scope": "#/properties/limits/properties/minPerEntry",
              "rule": {
                "effect": "HIDE",
                "condition": {
                  "scope": "#/properties/type/properties/kind",
                  "schema": {
                    "const": "cash"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "Category",
          "label": "Rounding",
          "elements": [
            {
              "type": "Label",
              "text": "Rounds amounts paid with this tender, for example to the smallest coin in use. Leave empty, or choose 'No rounding', for no rounding. A tender that gives no overpayment pays the amount due rounded to its unit: rounded up, the difference is booked as rounding; rounded down, the rest must be paid with another tender, unless the default cash tender's rounding takes it to zero. With 'No Split Payment' on, use no unit coarser than the store's cash rounding: the tender must pay exactly the order total."
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/rounding/properties/method"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/rounding/properties/precision",
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/rounding/properties/method",
                      "schema": {
                        "enum": [
                          "MATHEMATICAL",
                          "ROUND_HALF_DOWN",
                          "SCIENTIFIC"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Advanced",
          "elements": [
            {
              "type": "Label",
              "text": "Extra attributes are only for settings support asks you to add. Everything the other tabs offer must be set there, not here."
            },
            {
              "type": "Control",
              "scope": "#/properties/extraAttributes"
            }
          ]
        }
      ]
    }
  }
}
