{
  "type": "ListWithDetail",
  "scope": "#",
  "options": {
    "detail": {
      "type": "Categorization",
      "elements": [
        {
          "type": "Category",
          "label": "Tender",
          "elements": [
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/id"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/name"
                }
              ]
            },
            {
              "type": "Control",
              "scope": "#/properties/type"
            },
            {
              "type": "Control",
              "scope": "#/properties/currency",
              "options": {
                "enumSource": {
                  "type": "request",
                  "request": {
                    "url": "{api:ccc-api}/api/v1/config/cur.currencies.v1/values/{target.path}"
                  },
                  "response": {
                    "itemsPath": "value",
                    "valueKey": "id",
                    "labelKey": "id"
                  }
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/type/properties/kind",
                  "schema": {
                    "enum": [
                      "foreignCurrency"
                    ]
                  }
                }
              }
            },
            {
              "type": "Label",
              "text": "Choose the tender type first. Every setting left empty uses the default for the type, and each help text says what that default is. Most saved amounts and choices cannot be cleared: Save is then refused. To go back to the default, choose the default option where the list has one. Payment plugins, provider codes and the store currency are added automatically by Store Data."
            },
            {
              "type": "Control",
              "scope": "#/properties/restrictionRuleId"
            },
            {
              "type": "Control",
              "scope": "#/properties/description",
              "options": {
                "multi": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/disabled"
            }
          ]
        },
        {
          "type": "Category",
          "label": "At the Till",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/defaultTender"
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "VerticalLayout",
                      "elements": [
                        {
                          "type": "Label",
                          "text": "A cash changer tender is never the default cash tender: choose Automatic or No."
                        }
                      ],
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/behavior/properties/defaultTender",
                          "schema": {
                            "const": "YES"
                          }
                        }
                      }
                    }
                  ],
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/type/properties/hardware",
                      "schema": {
                        "const": "CASH_CHANGER_MACHINE"
                      }
                    }
                  }
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/type/properties/kind",
                  "schema": {
                    "const": "cash"
                  }
                }
              }
            },
            {
              "type": "Label",
              "text": "No split payment always takes the exact amount.",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/behavior/properties/exclusive",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/behavior/properties/overpayment"
                }
              ],
              "rule": {
                "effect": "HIDE",
                "condition": {
                  "scope": "#/properties/behavior/properties/exclusive",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Label",
                  "text": "This tender was saved with 'Exact Amount Only' on. 'Overpayment' replaced that setting, which is no longer read: choose an 'Overpayment' option to set how this tender handles overpayment.",
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/behavior/properties/exactAmountOnly",
                      "schema": {
                        "const": true
                      }
                    }
                  }
                }
              ],
              "rule": {
                "effect": "HIDE",
                "condition": {
                  "scope": "#/properties/behavior/properties/overpayment",
                  "schema": {
                    "enum": [
                      "TYPE_DEFAULT",
                      "EXACT_AMOUNT",
                      "WITH_CHANGE",
                      "WITHOUT_CHANGE"
                    ]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/exclusive"
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/lockTransaction"
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/blockCancel"
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "'Lock Sale After Payment Entry' and 'Block Cancelling the Sale' cannot both be on: the sale would then be stuck until it is paid in full. Turn one of them off."
                    }
                  ],
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/behavior/properties/blockCancel",
                      "schema": {
                        "const": true
                      }
                    }
                  }
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/behavior/properties/lockTransaction",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/payRemainingAmount"
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/prefillAmount"
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/cashDrawer"
            }
          ]
        },
        {
          "type": "Category",
          "label": "Change",
          "elements": [
            {
              "type": "Label",
              "text": "No change is given, because 'Overpayment' does not give change.",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/behavior/properties/overpayment",
                  "schema": {
                    "enum": [
                      "EXACT_AMOUNT",
                      "WITHOUT_CHANGE"
                    ]
                  }
                }
              }
            },
            {
              "type": "Label",
              "text": "No change is given, because 'No Split Payment' always takes the exact amount.",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/behavior/properties/exclusive",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "VerticalLayout",
                      "elements": [
                        {
                          "type": "Label",
                          "text": "Where change goes when the customer pays more than the amount due. Leave empty to give all change in the store's default cash tender. Used only when 'Overpayment' gives change; the type default gives change for cash, foreign currency, gift certificates, vouchers and checks."
                        },
                        {
                          "type": "Label",
                          "text": "A saved amount here cannot be cleared yet: Save is then refused. The alternate change tender list shows the tenders saved for this target: save a new tender before choosing it here. Choose an enabled tender, not loyalty points, that allows refunds and has no minimum amounts."
                        },
                        {
                          "type": "Control",
                          "scope": "#/properties/change/properties/tenderId",
                          "options": {
                            "enumSource": {
                              "type": "request",
                              "request": {
                                "url": "{api:ccc-api}/api/v1/config/che.tender.preview/values/{target.path}"
                              },
                              "response": {
                                "itemsPath": "value",
                                "valueKey": "id",
                                "labelKey": "name"
                              },
                              "display": {
                                "secondaryLabelKey": "type.kind"
                              }
                            }
                          }
                        },
                        {
                          "type": "HorizontalLayout",
                          "elements": [
                            {
                              "type": "Control",
                              "scope": "#/properties/change/properties/threshold"
                            },
                            {
                              "type": "Control",
                              "scope": "#/properties/change/properties/autoCompleteLimit"
                            }
                          ]
                        }
                      ],
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/behavior/properties/overpayment",
                          "schema": {
                            "const": "WITH_CHANGE"
                          }
                        }
                      }
                    },
                    {
                      "type": "VerticalLayout",
                      "elements": [
                        {
                          "type": "VerticalLayout",
                          "elements": [
                            {
                              "type": "Label",
                              "text": "Where change goes when the customer pays more than the amount due. Leave empty to give all change in the store's default cash tender. Used only when 'Overpayment' gives change; the type default gives change for cash, foreign currency, gift certificates, vouchers and checks."
                            },
                            {
                              "type": "Label",
                              "text": "A saved amount here cannot be cleared yet: Save is then refused. The alternate change tender list shows the tenders saved for this target: save a new tender before choosing it here. Choose an enabled tender, not loyalty points, that allows refunds and has no minimum amounts."
                            },
                            {
                              "type": "Control",
                              "scope": "#/properties/change/properties/tenderId",
                              "options": {
                                "enumSource": {
                                  "type": "request",
                                  "request": {
                                    "url": "{api:ccc-api}/api/v1/config/che.tender.preview/values/{target.path}"
                                  },
                                  "response": {
                                    "itemsPath": "value",
                                    "valueKey": "id",
                                    "labelKey": "name"
                                  },
                                  "display": {
                                    "secondaryLabelKey": "type.kind"
                                  }
                                }
                              }
                            },
                            {
                              "type": "HorizontalLayout",
                              "elements": [
                                {
                                  "type": "Control",
                                  "scope": "#/properties/change/properties/threshold"
                                },
                                {
                                  "type": "Control",
                                  "scope": "#/properties/change/properties/autoCompleteLimit"
                                }
                              ]
                            }
                          ],
                          "rule": {
                            "effect": "SHOW",
                            "condition": {
                              "scope": "#/properties/type/properties/kind",
                              "schema": {
                                "enum": [
                                  "cash",
                                  "foreignCurrency",
                                  "giftCertificate",
                                  "voucher",
                                  "check"
                                ]
                              }
                            }
                          }
                        },
                        {
                          "type": "Label",
                          "text": "With the type default this type takes the exact amount, so no change is given. Choose 'Allowed, give change' under 'Overpayment' to set change here.",
                          "rule": {
                            "effect": "SHOW",
                            "condition": {
                              "scope": "#/properties/type/properties/kind",
                              "schema": {
                                "enum": [
                                  "creditDebit",
                                  "mobile",
                                  "electronicGiftCard",
                                  "coupon",
                                  "manufacturerCoupon",
                                  "loyaltyRedemption",
                                  "organizationCharge",
                                  "houseAccount",
                                  "foodStamp",
                                  "wicCheck"
                                ]
                              }
                            }
                          }
                        }
                      ],
                      "rule": {
                        "effect": "HIDE",
                        "condition": {
                          "scope": "#/properties/behavior/properties/overpayment",
                          "schema": {
                            "const": "WITH_CHANGE"
                          }
                        }
                      }
                    }
                  ],
                  "rule": {
                    "effect": "HIDE",
                    "condition": {
                      "scope": "#/properties/behavior/properties/exclusive",
                      "schema": {
                        "const": true
                      }
                    }
                  }
                }
              ],
              "rule": {
                "effect": "HIDE",
                "condition": {
                  "scope": "#/properties/behavior/properties/overpayment",
                  "schema": {
                    "enum": [
                      "EXACT_AMOUNT",
                      "WITHOUT_CHANGE"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "type": "Category",
          "label": "Refunds",
          "elements": [
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Label",
                  "text": "On cash, change is paid out as a refund: cash always allows refunds, and the maximum refund also limits change."
                },
                {
                  "type": "Control",
                  "scope": "#/properties/refund/properties/skipAmountPrompt"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/refund/properties/maxAmount"
                },
                {
                  "type": "Label",
                  "text": "A saved refund amount cannot be cleared yet: Save is then refused."
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/type/properties/kind",
                  "schema": {
                    "const": "cash"
                  }
                }
              }
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/refund/properties/refundsAllowed"
                },
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "This tender was saved with 'Block Refunds' on. 'Refunds' replaced that setting, which is no longer read: choose a 'Refunds' option to set whether this tender refunds.",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/refund/properties/blockRefunds",
                          "schema": {
                            "const": true
                          }
                        }
                      }
                    }
                  ],
                  "rule": {
                    "effect": "HIDE",
                    "condition": {
                      "scope": "#/properties/refund/properties/refundsAllowed",
                      "schema": {
                        "enum": [
                          "TYPE_DEFAULT",
                          "YES",
                          "NO"
                        ]
                      }
                    }
                  }
                },
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/refund/properties/skipAmountPrompt"
                    },
                    {
                      "type": "HorizontalLayout",
                      "elements": [
                        {
                          "type": "Control",
                          "scope": "#/properties/refund/properties/maxAmount"
                        },
                        {
                          "type": "Control",
                          "scope": "#/properties/refund/properties/minAmount"
                        }
                      ]
                    },
                    {
                      "type": "Label",
                      "text": "A saved refund amount cannot be cleared yet: Save is then refused."
                    }
                  ],
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/refund/properties/refundsAllowed",
                      "schema": {
                        "const": "YES"
                      }
                    }
                  }
                },
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "VerticalLayout",
                      "elements": [
                        {
                          "type": "VerticalLayout",
                          "elements": [
                            {
                              "type": "Control",
                              "scope": "#/properties/refund/properties/skipAmountPrompt"
                            },
                            {
                              "type": "HorizontalLayout",
                              "elements": [
                                {
                                  "type": "Control",
                                  "scope": "#/properties/refund/properties/maxAmount"
                                },
                                {
                                  "type": "Control",
                                  "scope": "#/properties/refund/properties/minAmount"
                                }
                              ]
                            },
                            {
                              "type": "Label",
                              "text": "A saved refund amount cannot be cleared yet: Save is then refused."
                            }
                          ],
                          "rule": {
                            "effect": "HIDE",
                            "condition": {
                              "scope": "#/properties/type/properties/integration",
                              "schema": {
                                "const": "STANDALONE"
                              }
                            }
                          }
                        },
                        {
                          "type": "Label",
                          "text": "With the type default a standalone payment does not refund, because nothing checks it. Choose 'Allowed' to set refunds here.",
                          "rule": {
                            "effect": "SHOW",
                            "condition": {
                              "scope": "#/properties/type/properties/integration",
                              "schema": {
                                "const": "STANDALONE"
                              }
                            }
                          }
                        }
                      ],
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/type/properties/kind",
                          "schema": {
                            "enum": [
                              "cash",
                              "foreignCurrency",
                              "creditDebit",
                              "mobile",
                              "electronicGiftCard",
                              "giftCertificate",
                              "voucher",
                              "organizationCharge",
                              "houseAccount"
                            ]
                          }
                        }
                      }
                    },
                    {
                      "type": "Label",
                      "text": "With the type default this type does not refund. Choose 'Allowed' to set refunds here.",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/type/properties/kind",
                          "schema": {
                            "enum": [
                              "check",
                              "coupon",
                              "manufacturerCoupon",
                              "foodStamp",
                              "wicCheck",
                              "loyaltyRedemption"
                            ]
                          }
                        }
                      }
                    }
                  ],
                  "rule": {
                    "effect": "HIDE",
                    "condition": {
                      "scope": "#/properties/refund/properties/refundsAllowed",
                      "schema": {
                        "enum": [
                          "YES",
                          "NO"
                        ]
                      }
                    }
                  }
                }
              ],
              "rule": {
                "effect": "HIDE",
                "condition": {
                  "scope": "#/properties/type/properties/kind",
                  "schema": {
                    "const": "cash"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "Category",
          "label": "Limits",
          "elements": [
            {
              "type": "Label",
              "text": "Leave a limit empty for no limit. A saved limit cannot be cleared yet: Save is then refused."
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/limits/properties/maxPerSale"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/limits/properties/maxPerEntry"
                }
              ]
            },
            {
              "type": "Control",
              "scope": "#/properties/limits/properties/minPerEntry",
              "rule": {
                "effect": "HIDE",
                "condition": {
                  "scope": "#/properties/type/properties/kind",
                  "schema": {
                    "const": "cash"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "Category",
          "label": "Rounding",
          "elements": [
            {
              "type": "Label",
              "text": "Rounds amounts paid with this tender, for example to the smallest coin in use. Leave empty, or choose 'No rounding', for no rounding. The amount due is rounded with the default cash tender's rounding: a tender with a coarser unit that gives no overpayment cannot pay a remainder that is not a multiple of its unit."
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/rounding/properties/method"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/rounding/properties/precision",
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/rounding/properties/method",
                      "schema": {
                        "enum": [
                          "MATHEMATICAL",
                          "ROUND_HALF_DOWN",
                          "SCIENTIFIC"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Advanced",
          "elements": [
            {
              "type": "Label",
              "text": "Everything on this tab is only for what Extenda Retail support asks you to add. Everything the other tabs offer must be set there, not here."
            },
            {
              "type": "Label",
              "text": "Only use when Extenda Retail support asks for it. Names a payment plugin installed at the till, for example one delivered by an add-on team for a customer, which then approves every payment with this tender instead of the plugin Store Data chooses for the type. Store Data cannot check that the plugin is installed: with a wrong name, every payment with this tender fails at the till, and the cashier must use another tender. Extra attributes are passed to the plugin as written."
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/authorization/properties/plugin"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/authorization/properties/mode"
                }
              ]
            },
            {
              "type": "Control",
              "scope": "#/properties/extraAttributes"
            }
          ]
        }
      ]
    }
  }
}
