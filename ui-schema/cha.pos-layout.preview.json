    {
      "type": "Category",
      "label": "Always",
      "elements": [
        {
          "type": "Label",
          "text": "Buttons shown in every state, where the checkout allows the action. The other tabs add buttons for one state: between sales, during a sale, with a receipt line selected, or in refund mode. Order and section headings work across the tabs, so give the buttons order numbers that fit together. The note in brackets after an action says when the checkout allows it; a button in the wrong tab simply does not show. Leave Select type empty and add buttons inside to make a folder."
        },
        {
          "type": "ListWithDetail",
          "scope": "#/properties/mainMenu/properties/buttons",
          "options": {
            "detail": {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "HorizontalLayout",
