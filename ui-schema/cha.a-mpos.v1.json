{
  "type": "Categorization",
  "elements": [
    {
      "type": "Category",
      "label": "Infrastructure",
      "elements": [
        {
          "type": "Group",
          "label": "Checkout Engine Server",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/server/properties/host"
            },
            {
              "type": "Control",
              "scope": "#/properties/server/properties/networkCallTimeout"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Payment Connect",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/connect/properties/provider"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Auto Update",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/autoUpdate/properties/channel"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Log Upload",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/logs/properties/uploadEnabled"
            }
          ]
        }
      ]
    },
    {
      "type": "Category",
      "label": "Hardware & profile",
      "elements": [
        {
          "type": "Group",
          "label": "Peripherals",
          "elements": [
            {
              "type": "Group",
              "label": "Printer",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/peripherals/properties/printer/properties/enabled"
                }
              ]
            },
            {
              "type": "Group",
              "label": "Camera scanner",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/peripherals/properties/cameraScanner/properties/enabled"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/peripherals/properties/cameraScanner/properties/whitelistedPrompts"
                }
              ]
            },
            {
              "type": "Group",
              "label": "Scan",
              "elements": [
                {
                  "type": "Group",
                  "label": "Audio",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/peripherals/properties/scan/properties/audio/properties/enabled"
                    },
                    {
                      "type": "Group",
                      "label": "Success",
                      "elements": [
                        {
                          "type": "Control",
                          "scope": "#/properties/peripherals/properties/scan/properties/audio/properties/success/properties/enabled"
                        }
                      ]
                    },
                    {
                      "type": "Group",
                      "label": "Error",
                      "elements": [
                        {
                          "type": "Control",
                          "scope": "#/properties/peripherals/properties/scan/properties/audio/properties/error/properties/enabled"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "ICD — MPOS (Tablet only)",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/peripherals/properties/icd/properties/enabled"
                }
              ]
            }
          ]
        },
        {
          "type": "Control",
          "scope": "#/properties/trainingModeAvailable"
        }
      ]
    },
    {
      "type": "Category",
      "label": "Branding",
      "elements": [
        {
          "type": "Group",
          "label": "Theme",
          "elements": [
            {
              "type": "Group",
              "label": "Colors",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/theme/properties/colors/properties/primary"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/theme/properties/colors/properties/primaryDark"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/theme/properties/colors/properties/primaryLight"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/theme/properties/colors/properties/secondary"
                }
              ]
            },
            {
              "type": "Group",
              "label": "Font families",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/theme/properties/fontFamilies/properties/heading"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/theme/properties/fontFamilies/properties/default"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/theme/properties/fontFamilies/properties/monospace"
                }
              ]
            },
            {
              "type": "Control",
              "scope": "#/properties/theme/properties/roundness"
            }
          ]
        },
        {
          "type": "Control",
          "scope": "#/properties/wallpaperUri"
