{
  "type": "ListWithDetail",
  "scope": "#",
  "x-autoFill": [
    {
      "description": "Cash-like type chosen: offer overpayment. Leaving a cash-like type removes the setting, because the other types always take the exact amount.",
      "when": {
        "scope": "#/properties/type/properties/kind",
        "schema": {
          "enum": [
            "cash",
            "foreignCurrency",
            "giftCertificate",
            "voucher",
            "check"
          ]
        }
      },
      "set": [
        {
          "scope": "#/properties/behavior/properties/exactAmountOnly",
          "value": false
        }
      ]
    },
    {
      "description": "No split payment on a cash-like type: the tender must take the exact amount. Switching it off removes the forced value.",
      "when": {
        "scope": "#",
        "schema": {
          "allOf": [
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "cash",
                        "foreignCurrency",
                        "giftCertificate",
                        "voucher",
                        "check"
                      ]
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "behavior"
              ],
              "properties": {
                "behavior": {
                  "type": "object",
                  "required": [
                    "exclusive"
                  ],
                  "properties": {
                    "exclusive": {
                      "const": true
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "set": [
        {
          "scope": "#/properties/behavior/properties/exactAmountOnly",
          "value": true
        }
      ]
    },
    {
      "description": "Change and rounding exist only for a cash-like type that is not limited to the exact amount. They are removed when the type changes or 'Exact Amount Only' is switched on, and offered again otherwise. Must run after the no-split-payment rule.",
      "when": {
        "scope": "#",
        "schema": {
          "allOf": [
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "cash",
                        "foreignCurrency",
                        "giftCertificate",
                        "voucher",
                        "check"
                      ]
                    }
                  }
                }
              }
            },
            {
              "not": {
                "type": "object",
                "required": [
                  "behavior"
                ],
                "properties": {
                  "behavior": {
                    "type": "object",
                    "required": [
                      "exactAmountOnly"
                    ],
                    "properties": {
                      "exactAmountOnly": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "set": [
        {
          "scope": "#/properties/change",
          "value": {}
        },
        {
          "scope": "#/properties/rounding",
          "value": {}
        }
      ]
    },
    {
      "description": "Types where cancelling can be blocked. Leaving them removes the setting, which the other types do not allow.",
      "when": {
        "scope": "#",
        "schema": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "giftCertificate",
                    "voucher",
                    "check",
                    "coupon",
                    "manufacturerCoupon",
                    "organizationCharge",
                    "houseAccount",
                    "foodStamp",
                    "wicCheck"
                  ]
                }
              },
              "not": {
                "type": "object",
                "required": [
                  "creditCheck"
                ],
                "properties": {
                  "creditCheck": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "set": [
        {
          "scope": "#/properties/behavior/properties/blockCancel",
          "value": false
        }
      ]
    },
    {
      "description": "Types that can pay the remaining amount automatically. Leaving them removes the setting.",
      "when": {
        "scope": "#",
        "schema": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "creditDebit",
                    "mobile",
                    "electronicGiftCard",
                    "organizationCharge",
                    "houseAccount",
                    "check",
                    "foreignCurrency",
                    "foodStamp",
                    "wicCheck"
                  ]
                }
              }
            }
          }
        }
      },
      "set": [
        {
          "scope": "#/properties/behavior/properties/payRemainingAmount",
          "value": false
        }
      ]
    },
    {
      "description": "Types that can refund. Leaving them, or choosing standalone mobile, removes the refund settings.",
      "when": {
        "scope": "#",
        "schema": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "cash",
                    "foreignCurrency",
                    "creditDebit",
                    "mobile",
                    "electronicGiftCard",
                    "organizationCharge",
                    "houseAccount",
                    "giftCertificate",
                    "voucher",
                    "check"
                  ]
                }
              },
              "not": {
                "type": "object",
                "required": [
                  "integration"
                ],
                "properties": {
                  "integration": {
                    "const": "STANDALONE"
                  }
                }
              }
            }
          }
        }
      },
      "set": [
        {
          "scope": "#/properties/refund",
          "value": {}
        }
      ]
    },
    {
      "description": "Cash always allows refunds: clear 'Block Refunds' carried over from another type, so the cash refund limits stay visible. Must run after the refund rule.",
      "when": {
        "scope": "#/properties/type/properties/kind",
        "schema": {
          "const": "cash"
        }
      },
      "set": [
        {
          "scope": "#/properties/refund/properties/blockRefunds",
          "value": false
        }
      ]
    }
  ],
  "options": {
    "detail": {
      "type": "Categorization",
      "elements": [
        {
          "type": "Category",
          "label": "Tender",
          "elements": [
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/id"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/name"
                }
              ]
            },
            {
              "type": "Control",
              "scope": "#/properties/type"
            },
            {
              "type": "Label",
              "text": "Choose the tender type first. The other tabs offer only what makes sense for that type, and every setting left empty uses the default for the type. Payment plugins, provider codes and the store currency are added automatically by Store Data."
            },
            {
              "type": "Control",
              "scope": "#/properties/restrictionRuleId"
            },
            {
              "type": "Control",
              "scope": "#/properties/description",
              "options": {
                "multi": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/disabled"
            }
          ]
        },
        {
          "type": "Category",
          "label": "At the Till",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/defaultTender"
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/behavior/properties/exactAmountOnly",
                  "rule": {
                    "effect": "DISABLE",
                    "condition": {
                      "scope": "#/properties/behavior/properties/exclusive",
                      "schema": {
                        "const": true
                      }
                    }
                  }
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/type/properties/kind",
                  "schema": {
                    "enum": [
                      "cash",
                      "foreignCurrency",
                      "giftCertificate",
                      "voucher",
                      "check"
                    ]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/exclusive"
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/lockTransaction"
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/behavior/properties/blockCancel",
                  "rule": {
                    "effect": "HIDE",
                    "condition": {
                      "scope": "#/properties/type/properties/creditCheck",
                      "schema": {
                        "const": true
                      }
                    }
                  }
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/type/properties/kind",
                  "schema": {
                    "enum": [
                      "giftCertificate",
                      "voucher",
                      "check",
                      "coupon",
                      "manufacturerCoupon",
                      "organizationCharge",
                      "houseAccount",
                      "foodStamp",
                      "wicCheck"
                    ]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/payRemainingAmount",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/type/properties/kind",
                  "schema": {
                    "enum": [
                      "creditDebit",
                      "mobile",
                      "electronicGiftCard",
                      "organizationCharge",
                      "houseAccount",
                      "check",
                      "foreignCurrency",
                      "foodStamp",
                      "wicCheck"
                    ]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/prefillAmount"
            },
            {
              "type": "Control",
              "scope": "#/properties/behavior/properties/cashDrawer"
            }
          ]
        },
        {
          "type": "Category",
          "label": "Change",
          "elements": [
            {
              "type": "Label",
              "text": "No change is given, because 'Exact Amount Only' is on.",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/behavior/properties/exactAmountOnly",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Label",
                  "text": "Leave everything empty to give all change in the store's default cash tender."
                },
                {
                  "type": "Control",
                  "scope": "#/properties/change/properties/tenderId"
                },
                {
                  "type": "HorizontalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/change/properties/threshold"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/change/properties/autoCompleteLimit"
                    }
                  ]
                }
              ],
              "rule": {
                "effect": "HIDE",
                "condition": {
                  "scope": "#/properties/behavior/properties/exactAmountOnly",
                  "schema": {
                    "const": true
                  }
                }
              }
            }
          ],
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/type/properties/kind",
              "schema": {
                "enum": [
                  "cash",
                  "foreignCurrency",
                  "giftCertificate",
                  "voucher",
                  "check"
                ]
              }
            }
          }
        },
        {
          "type": "Category",
          "label": "Refunds",
          "elements": [
            {
              "type": "Label",
              "text": "Standalone mobile payments cannot be refunded at the till: a mobile refund needs the original app payment.",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/type/properties/integration",
                  "schema": {
                    "const": "STANDALONE"
                  }
                }
              }
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/refund/properties/blockRefunds",
                  "rule": {
                    "effect": "HIDE",
                    "condition": {
                      "scope": "#/properties/type/properties/kind",
                      "schema": {
                        "const": "cash"
                      }
                    }
                  }
                },
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/refund/properties/skipAmountPrompt"
                    },
                    {
                      "type": "HorizontalLayout",
                      "elements": [
                        {
                          "type": "Control",
                          "scope": "#/properties/refund/properties/maxAmount"
                        },
                        {
                          "type": "Control",
                          "scope": "#/properties/refund/properties/minAmount",
                          "rule": {
                            "effect": "HIDE",
                            "condition": {
                              "scope": "#/properties/type/properties/kind",
                              "schema": {
                                "const": "cash"
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "Label",
                      "text": "On cash, change is paid out as a refund: the maximum refund also limits change, and cash always allows refunds.",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/type/properties/kind",
                          "schema": {
                            "const": "cash"
                          }
                        }
                      }
                    }
                  ],
                  "rule": {
                    "effect": "HIDE",
                    "condition": {
                      "scope": "#/properties/refund/properties/blockRefunds",
                      "schema": {
                        "const": true
                      }
                    }
                  }
                }
              ],
              "rule": {
                "effect": "HIDE",
                "condition": {
                  "scope": "#/properties/type/properties/integration",
                  "schema": {
                    "const": "STANDALONE"
                  }
                }
              }
            }
          ],
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/type/properties/kind",
              "schema": {
                "enum": [
                  "cash",
                  "foreignCurrency",
                  "creditDebit",
                  "mobile",
                  "electronicGiftCard",
                  "organizationCharge",
                  "houseAccount",
                  "giftCertificate",
                  "voucher",
                  "check"
                ]
              }
            }
          }
        },
        {
          "type": "Category",
          "label": "Limits",
          "elements": [
            {
              "type": "Label",
              "text": "Leave a limit empty for no limit."
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/limits/properties/maxPerSale"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/limits/properties/maxPerEntry"
                }
              ]
            },
            {
              "type": "Control",
              "scope": "#/properties/limits/properties/minPerEntry",
              "rule": {
                "effect": "HIDE",
                "condition": {
                  "scope": "#/properties/type/properties/kind",
                  "schema": {
                    "const": "cash"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "Category",
          "label": "Rounding",
          "elements": [
            {
              "type": "Label",
              "text": "Rounding is not available with 'Exact Amount Only': a rounded amount above the amount due would be rejected.",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/behavior/properties/exactAmountOnly",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Label",
                  "text": "Leave empty for no rounding. Choose a method and the smallest coin in use to round amounts paid with this tender."
                },
                {
                  "type": "HorizontalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/rounding/properties/method"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/rounding/properties/precision",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/rounding/properties/method",
                          "schema": {
                            "enum": [
                              "MATHEMATICAL",
                              "ROUND_HALF_DOWN"
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              ],
              "rule": {
                "effect": "HIDE",
                "condition": {
                  "scope": "#/properties/behavior/properties/exactAmountOnly",
                  "schema": {
                    "const": true
                  }
                }
              }
            }
          ],
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/type/properties/kind",
              "schema": {
                "enum": [
                  "cash",
                  "foreignCurrency",
                  "giftCertificate",
                  "voucher",
                  "check"
                ]
              }
            }
          }
        },
        {
          "type": "Category",
          "label": "Advanced",
          "elements": [
            {
              "type": "Label",
              "text": "Extra attributes are only for settings Extenda Retail support asks you to add. Everything this form offers must be set in the form, not here."
            },
            {
              "type": "Control",
              "scope": "#/properties/extraAttributes"
            }
          ]
        }
      ]
    }
  }
}
