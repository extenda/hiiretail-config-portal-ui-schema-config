        {
          "type": "Group",
          "label": "External Links",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/externalLinks/properties/enabled"
            },
            {
              "type": "Control",
              "scope": "#/properties/externalLinks/properties/links"
            }
          ]
        },
        {
          "type": "Control",
          "scope": "#/properties/inAppLinksEnabled"
        }
      ]
    },
