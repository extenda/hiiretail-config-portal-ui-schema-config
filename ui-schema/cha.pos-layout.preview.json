                      "scope": "#/properties/action"
                    }
                  ]
                },
                {
                  "type": "HorizontalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/icon"
                    },
                    {
                      "type": "Control",
