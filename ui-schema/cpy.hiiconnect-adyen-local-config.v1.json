{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "HorizontalLayout",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/environment",
          "label": "Environment"
        },
        {
          "type": "Control",
          "scope": "#/properties/apiKey",
          "label": "API key",
          "options": {
            "mask": true
          }
        }
      ]
    },
    {
      "type": "Label",
      "text": "Live: real cards are charged.",
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/environment",
          "schema": {
            "const": "PRODUCTION"
          }
        }
      }
    },
    {
      "type": "HorizontalLayout",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/encryptionKeyIdentifier",
          "label": "Key name"
        },
        {
          "type": "Control",
          "scope": "#/properties/encryptionKeyPassphrase",
          "label": "Key passphrase",
          "options": {
            "mask": true
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/encryptionKeyVersion",
          "label": "Key version"
        }
      ]
    },
    {
      "type": "Control",
      "scope": "#/properties/webhookPort",
      "label": "Status port"
    }
  ]
}
